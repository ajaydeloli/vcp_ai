# Environment secrets and credentials template
# Never commit real credentials to version control (.env is in .gitignore).

# Kite Connect API Credentials
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_ACCESS_TOKEN=your_kite_access_token_here

# Dhan API Credentials (secondary/future)
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# Application Settings
VCP_ENV=development
VCP_LOG_LEVEL=INFO
VCP_LOG_JSON=false

# Upstox API Credentials (used for corporate actions)
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here
